# Tor control password — change this before any deployment
TOR_CONTROL_PASSWORD=torxy_secret_change_this

# Tor circuit hostnames (matches docker-compose service names)
TOR1_HOST=tor1
TOR2_HOST=tor2
TOR3_HOST=tor3

# Internal ports — same across containers since each is isolated
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# Proxy server
# 0.0.0.0 is correct inside the container: docker-compose publishes the port on host
# loopback only. If you run bin/server.php directly on a host, set 127.0.0.1 instead.
PROXY_HOST=0.0.0.0
PROXY_PORT=8080

# Access control. Anyone who can reach the listener can use your Tor circuits, so set
# credentials, an IP allowlist, or both before exposing this beyond localhost.
# Credentials are enforced only when BOTH are non-empty.
PROXY_AUTH_USER=
PROXY_AUTH_PASSWORD=

# Comma-separated addresses or CIDR blocks. Empty allows any client that can connect.
PROXY_ALLOWED_IPS=

# Circuit rotation
# strategy: round_robin | random | per_request
TOR_ROTATION_STRATEGY=round_robin
# Seconds between background NEWNYM rotations of every circuit. 0 disables it.
TOR_ROTATION_INTERVAL=0

# Circuit health
# Consecutive transport failures before a circuit is dropped from rotation.
TOR_HEALTH_FAILURE_THRESHOLD=3
# Seconds between recovery probes of circuits that are out of rotation. 0 disables probing,
# which means a circuit that fails stays out until the process restarts.
TOR_HEALTH_INTERVAL=30
# host:port dialled through the circuit to test it. An IP avoids depending on exit DNS.
TOR_HEALTH_PROBE_TARGET=1.1.1.1:443