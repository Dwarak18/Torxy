{
    "name": "torxy/framework",
    "description": "PHP Tor Reverse Proxy Framework — multi-circuit IP masking",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "react/http": "^1.9",
        "react/socket": "^1.15",
        "react/event-loop": "^1.5",
        "vlucas/phpdotenv": "^5.6",
        "clue/socks-react": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Torxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Torxy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --configuration=phpstan.neon.dist",
        "check": [
            "@test",
            "@stan"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the unit test suite (tests/integration.sh is separate — it needs docker and Tor)",
        "stan": "Run static analysis",
        "check": "Run unit tests then static analysis"
    },
    "config": {
        "sort-packages": true
    }
}
